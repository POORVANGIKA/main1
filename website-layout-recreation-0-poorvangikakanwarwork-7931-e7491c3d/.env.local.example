# Copy this file to .env.local and fill in your real credentials.
# Do not commit .env.local if it contains secrets.

# PostgreSQL database URL for Drizzle ORM and Better Auth.
DATABASE_URL=postgresql://user:password@host:5432/database

# Better Auth configuration.
BETTER_AUTH_SECRET=your_generated_secret_32_chars_minimum
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob storage token (if used by this app).
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
